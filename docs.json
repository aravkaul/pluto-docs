{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Pluto",
  "colors": {
    "primary": "#858585",
    "light": "#FFFFFF",
    "dark": "#000000"
  },
  "favicon": {
    "light": "/images/pluto-logo.png",
    "dark": "/images/pluto-blk.png"
  },
  "navigation": {
    "global": {
      "anchors": [
        {
          "anchor": "Documentation",
          "href": "https://mintlify.com/docs",
          "icon": "book-open-cover"
        },
        {
          "anchor": "Blog",
          "href": "https://mintlify.com/blog",
          "icon": "newspaper"
        }
      ]
    },
    "tabs": [
      {
        "tab": "Home",
        "pages": [
          "index"
        ]
      },
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Guide",
            "pages": [
              "quickstart"
            ]
          }
        ]
      },
      {
        "tab": "API Reference"
      }
    ]
  },
  "logo": {
    "light": "/images/a50a6fa2-97f1-402b-aa5d-124851b61d8e.png",
    "dark": "/images/pluto-blk.png"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:support@pluto.onl"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://app.pluto.onl"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/plutonow_",
      "github": "https://github.com/plutonow",
      "linkedin": "https://linkedin.com/company/plutonow"
    }
  },
  "description": "Docs for Pluto",
  "icons": {
    "library": "fontawesome"
  },
  "banner": {
    "content": "Docs is live!"
  },
  "fonts": {
    "family": "Inter",
    "weight": 400
  },
  "styling": {
    "codeblocks": "system"
  }
}
